# =============================================================================
# GENERAL
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# POSTGRESQL (interno - Docker)
# =============================================================================
POSTGRES_DB=emeb_crm
POSTGRES_USER=emeb
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://emeb:changeme@postgres:5432/emeb_crm

# =============================================================================
# REDIS (interno - Docker)
# =============================================================================
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# =============================================================================
# WHATSAPP API
# =============================================================================
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
# Teléfono interno que recibe avisos de derivación de la IA (formato E.164)
HUMAN_ATTENTION_WHATSAPP_PHONE=+34600000000
# Plantilla aprobada de Meta para alertas fuera de la ventana de 24 horas.
# HUMAN_ATTENTION_WHATSAPP_TEMPLATE=alerta_atencion_humana

# =============================================================================
# JWT / AUTH
# =============================================================================
JWT_SECRET=change_this_to_a_very_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_URL=http://localhost:3000
